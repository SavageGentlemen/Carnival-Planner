# ==============================================================================
# CARIBBEAN CARNIVAL PLANNER - EMAIL & BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Email Service / SMTP Configuration (functions2/emailService.js)
# ------------------------------------------------------------------------------
# Set EMAIL_DEV_MODE=true for local mock logging to console without sending real emails
EMAIL_DEV_MODE=false

# Generic SMTP Provider (Recommended for Plunk, Brevo, Resend, Amazon SES, Postmark, Mailgun)
# Example (Brevo): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false
# Example (Resend): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true
# Example (Local Mailpit): SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="Caribbean Carnival Planner" <noreply@carnival-planner.com>

# Legacy / Fallback Gmail Configuration (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Listmonk Configuration (for High-Volume Broadcasts & Marketing Promos)
# ------------------------------------------------------------------------------
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=admin
LISTMONK_API_TOKEN=
LISTMONK_PROMO_LIST_ID=1
