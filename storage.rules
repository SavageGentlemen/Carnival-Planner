rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /promoAds/{allPaths=**} {
      // Anyone can read promo ads (for displaying to free users)
      allow read: if true;
      // Only admin can upload/delete ads
      allow write: if request.auth != null && (
        request.auth.token.email in [
          'djkrss1@gmail.com', 
          'info@moymeetsworld.com', 
          'moymeetsworld@gmail.com',
          'defoursemoy@gmail.com',
          'info@moysworld.com'
        ]
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Travel Assets (Moy Meets World Package Photos & Banners)
    match /travel_assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email in [
          'djkrss1@gmail.com', 
          'info@moymeetsworld.com', 
          'moymeetsworld@gmail.com',
          'defoursemoy@gmail.com',
          'info@moysworld.com'
        ]
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Squad Chat Media
    match /squads/{squadId}/{allPaths=**} {
      // Allow any auth user to upload/read. 
      // Ideally we'd check membership via Firestore, but Storage rules can't easily do that.
      // This is secure enough for chat media in this context.
      allow read, write: if request.auth != null;
    }
    
    // User Profile Photos
    match /profiles/{userId}/{allPaths=**} {
      // Anyone can read profile photos (for public profiles)
      allow read: if true;
      // Only the owner can upload/delete their own photos
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Marketplace Images
    match /marketplace/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3D Costume Models (AR)
    match /models/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
