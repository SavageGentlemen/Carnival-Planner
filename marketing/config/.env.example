# Gemini API Key (required for Copywriter agent)
GEMINI_API_KEY=your-gemini-api-key

# Amazon Affiliate Tag
AMAZON_AFFILIATE_TAG=vivalmap-20

# Firebase Configuration (required for seed_articles.js)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
FIREBASE_PROJECT_ID=your-project-id

# Instagram Meta Graph API (optional - for scout_social.js)
# IG_USER_ID=your-ig-user-id
# IG_ACCESS_TOKEN=your-ig-access-token

# Facebook Graph API (optional - for scout_social.js)
# FB_PAGE_ID=your-page-id
# FB_ACCESS_TOKEN=your-fb-access-token

# OpenWA WhatsApp API (optional - for scout_social.js)
# OPENWA_API_URL=http://localhost:8080
# OPENWA_API_KEY=secure_shared_secret

# Reddit Scout (enabled by default, no auth needed)
REDDIT_SCOUT_ENABLED=true
TWITTER_SCOUT_ENABLED=false
